# Runtime mode
NODE_ENV=development
TOURISM_DEPLOYMENT_ENV=development
PORT=3000

# Database and session security (replace locally; never commit real values)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=true
JWT_SECRET=replace-with-at-least-32-random-characters

# Identity provider: keep manus during transition, or use standards-based oidc.
AUTH_PROVIDER=manus
VITE_AUTH_PROVIDER=manus
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
VITE_AUTH_CLIENT_ID=
VITE_APP_ID=replace-with-development-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OWNER_OPEN_ID=replace-with-development-owner-id
OWNER_NAME=Development Owner

# Institutional OIDC (required only when AUTH_PROVIDER=oidc)
OIDC_ISSUER_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_USERINFO_URL=
VITE_OIDC_AUTHORIZATION_URL=

# Optional Manus/Forge-backed features. Leave blank to keep those features unavailable.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Public download base. Keep the legacy proxy now, or point both values to an institutional CDN later.
PUBLIC_STORAGE_BASE_URL=/manus-storage
VITE_STORAGE_PUBLIC_BASE_URL=/manus-storage

# Optional analytics. Both values are required before the script is enabled.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
