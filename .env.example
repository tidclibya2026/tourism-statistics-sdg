# Runtime mode
NODE_ENV=development
TOURISM_DEPLOYMENT_ENV=development
PORT=3000

# Database and session security (replace locally; never commit real values)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=true
JWT_SECRET=replace-with-at-least-32-random-characters

# Current identity provider. Manus remains supported while an institutional provider is prepared.
AUTH_PROVIDER=manus
VITE_APP_ID=replace-with-development-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im
OWNER_OPEN_ID=replace-with-development-owner-id
OWNER_NAME=Development Owner

# Optional Manus/Forge-backed features. Leave blank to keep those features unavailable.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics. Both values are required before the script is enabled.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
